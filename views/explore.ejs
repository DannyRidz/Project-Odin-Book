<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Explore posts | Odin Book</title>
  </head>
  <body>
    <h1>Explore posts</h1>
    <% if (isGuest) { %>
    <p>Guest preview is read-only. <a href="/sign-up">Create an account</a> to join in.</p>
    <% } %>
    <p><a href="/">Home</a></p>

    <% if (posts.length === 0) { %>
      <p>No posts yet.</p>
    <% } %>

    <% for (const post of posts) { %>
  <%- include("partials/post", {
    post,
    showActions: !isGuest,
    returnTo: "/explore"
  }) %>
<% } %>
  </body>
</html>