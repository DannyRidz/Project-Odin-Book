<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>My profile | Odin Book</title>
  </head>
  <body>
    <h1>My profile</h1>
    <p><a href="/">Home</a></p>

    <img
      src="<%= user.photoUrl || '/default-avatar.svg' %>"
      alt="Profile picture for <%= user.displayName %>"
      width="100"
      height="100"
    >
    <p>@<%= user.username %></p>

    <% if (error) { %>
      <p role="alert"><%= error %></p>
    <% } %>

    <form action="/profile/setup" method="post">
      <label for="displayName">Display name</label>
      <input
        id="displayName"
        name="displayName"
        value="<%= user.displayName %>"
        maxlength="50"
        required
      >

      <br>

      <label for="bio">Bio</label>
      <textarea id="bio" name="bio" maxlength="160"><%= user.bio || '' %></textarea>

      <% if (!user.photoUrl) { %>
        <br>
        <label for="photoUrl">Initial profile picture URL</label>
        <input
          id="photoUrl"
          name="photoUrl"
          type="url"
          maxlength="2048"
          placeholder="https://example.com/picture.jpg"
        >
      <% } %>

      <br>
      <button type="submit">Save profile</button>
    </form>
  </body>
</html>