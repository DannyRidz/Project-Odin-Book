<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>My posts | Odin Book</title>
  </head>
  <body>
    <h1>My posts</h1>
    <p><a href="/">Home</a></p>

    <form action="/posts" method="post">
      <label for="content">What would you like to share?</label>
      <br>
      <textarea id="content" name="content" rows="5" cols="50" maxlength="500" required></textarea>
      <br>
      <label for="imageUrl">Image URL (optional)</label>
<br>
<input
  id="imageUrl"
  name="imageUrl"
  type="url"
  maxlength="2048"
  placeholder="https://example.com/photo.jpg"
>
<br>
      <button type="submit">Post</button>
    </form>

    <% if (error) { %>
      <p role="alert"><%= error %></p>
    <% } %>

    <% if (posts.length === 0) { %>
      <p>You have not posted yet.</p>
    <% } %>

    <% for (const post of posts) { %>
  <%- include("partials/post", { post, showActions: false }) %>
<% } %>
  </body>
</html>