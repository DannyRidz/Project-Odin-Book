<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Odin Book</title>
  </head>
  <body>
    <h1>Odin Book</h1>
    <p>Users: <%= userCount %></p>

    <% if (user) { %>
      <p>Signed in as <%= user.displayName %> (@<%= user.username %>).</p>
      <form action="/log-out" method="post">
        <button type="submit">Sign out</button>
      </form>
      <p><a href="/connections">Connections</a></p>
    <% } else { %>
      <p><a href="/log-in">Sign in</a> or <a href="/sign-up">create an account</a>.</p>
    <% } %>
  </body>
</html>