<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Home feed | Odin Book</title>
  </head>
  <body>
    <h1>Odin Book</h1>
    <p>Signed in as <%= user.displayName %> (@<%= user.username %>).</p>

    <form action="/log-out" method="post">
      <button type="submit">Sign out</button>
    </form>

    <p><a href="/connections">Connections</a></p>
    <p><a href="/posts">My posts</a></p>
    <p><a href="/explore">Explore posts</a></p>
    <p><a href="/profile/setup">My profile</a></p>
    <p><a href="/users/<%= user.username %>">View my profile</a></p>

    <h2>Your feed</h2>
    <% if (posts.length === 0) { %>
      <p>No posts yet. Write a post or follow someone.</p>
    <% } %>

    <% for (const post of posts) { %>
      <%- include("partials/post", {
        post,
        showActions: true,
        returnTo: "/"
      }) %>
    <% } %>
  </body>
</html>